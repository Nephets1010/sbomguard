<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.nephets</groupId>
    <artifactId>sbomguard</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>sbomguard-store</artifactId>
  <name>sbomguard-store</name>
  <description>SBOM 摄入 / 解析层（零 Spring）：将 CycloneDX 1.4/1.5 JSON 解析为 contract 领域模型，并对外暴露解析门面 SbomParsers。是核心领域对象的供给侧。</description>

  <!--
    ★ 本模块严禁引入任何 org.springframework.* 依赖（与 core / contract 一致，守住零 Spring 边界）。
  -->

  <dependencies>
    <dependency>
      <groupId>io.github.nephets</groupId>
      <artifactId>sbomguard-contract</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- 可观测日志（SLF4J API，版本由 Spring Boot 父 POM 管理；非 org.springframework）。 -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>**/package-info.java</exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <properties>
    <!-- 解析层分支较多（多规格版本 / 多种 tools 形状 / 多种许可证形状），门禁略低于纯值对象模块。 -->
    <jacoco.line.minimum>0.70</jacoco.line.minimum>
    <jacoco.report.skip>false</jacoco.report.skip>
  </properties>
</project>
